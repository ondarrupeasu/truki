# Pasa la cabecera Authorization a PHP (necesario en Apache/Infomaniak para el login por token)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Nunca servir ningún archivo de configuración (config.php, config.prod.php, etc.)
<FilesMatch "^config.*\.php$">
  Require all denied
</FilesMatch>
