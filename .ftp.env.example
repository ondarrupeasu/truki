# Copia este archivo a  .ftp.env  y rellena con los datos FTP de Infomaniak.
# IMPORTANTE: .ftp.env NO se sube a git — tus credenciales se quedan en tu Mac.
#
# Los datos FTP los tienes en el Manager de Infomaniak:
#   Alojamiento → FTP/SSH → (crea o mira un usuario FTP)
#
FTP_HOST="ftp.cinemafilmak.com"      # o el host FTP que te indique Infomaniak
FTP_USER="tu_usuario_ftp"
FTP_PASS="tu_contraseña_ftp"
FTP_DIR="/truki"                      # carpeta del subdominio truki.cinemafilmak.com
                                      # (mira en tu FTP cuál es la ruta exacta del subdominio)
