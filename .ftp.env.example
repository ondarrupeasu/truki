# Datos FTP de Infomaniak para desplegar Truki.
#
# DÓNDE PONERLOS (elige uno; NUNCA se suben a git ni se pegan en el chat):
#   · Recomendado (convención CinemaFilmak):  ~/.truki/infomaniak_ftp.env
#   · Alternativa local:                       ./.ftp.env
#
# Los datos FTP están en el Manager de Infomaniak → Alojamiento → FTP/SSH.
#
# ⚠️ IMPORTANTE: el usuario FTP "acotado" de Infomaniak conecta por
#    FTPS EXPLÍCITO (puerto 21) — el script ya usa --ssl-reqd. NO es SFTP,
#    aunque en FileZilla el usuario general sí vaya por SFTP.
#
FTP_HOST="xxxx.ftp.infomaniak.com"   # el host FTP exacto que te da el panel
FTP_USER="tu_usuario_ftp"
FTP_PASS="tu_contraseña_ftp"
FTP_DIR="/truki"                      # carpeta del subdominio truki.cinemafilmak.com
                                      # (mira en tu FTP la ruta exacta del subdominio)
